# Copy to .env and fill in. Never commit .env.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=report.example.local
# DJANGO_CSRF_TRUSTED_ORIGINS=https://report.example.local
TIME_ZONE=Asia/Jakarta

# "demo" = synthetic data, "live" = Prometheus + Jira Cloud
DATA_SOURCE_MODE=live

PROVIDER_NAME=PT IDX Solusi Teknologi Informasi
PROVIDER_SHORT=IDXSTI
DEFAULT_SLA_TARGET=99.412

# PostgreSQL (leave POSTGRES_DB empty to use SQLite)
POSTGRES_DB=report
POSTGRES_USER=report
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db

# Prometheus (the datasource behind Grafana)
PROMETHEUS_URL=http://prometheus.internal:9090
PROMETHEUS_BEARER_TOKEN=
PROMETHEUS_USERNAME=
PROMETHEUS_PASSWORD=
PROMETHEUS_STEP_SECONDS=900

# Jira Cloud (API token: https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=service-account@example.com
JIRA_API_TOKEN=
JIRA_DEFAULT_INCIDENT_JQL=issuetype = Incident
JIRA_DEFAULT_REQUEST_JQL=issuetype = "Service Request"
JIRA_FOLLOWUP_FIELD=

# SMTP
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=cloud-report@example.com
INTERNAL_EMAIL_DOMAINS=example.com
